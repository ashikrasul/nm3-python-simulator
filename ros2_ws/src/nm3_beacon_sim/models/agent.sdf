<?xml version="1.0"?>
<sdf version="1.6">
  <model name="agent">
    <link name="base_footprint">
      <gravity>false</gravity>
      <inertial><mass>10</mass>
        <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="hull">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>1.6 0.7 0.3</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="bow">
        <pose>0.9 0 0.15 0 0 0</pose>
        <geometry><box><size>0.2 0.3 0.3</size></box></geometry>
        <material><ambient>1 0.3 0.1 1</ambient><diffuse>1 0.3 0.1 1</diffuse></material>
      </visual>
      <!-- Transducer pole down to z_s = -2 m (display only; ranging depth comes from the JSON). -->
      <visual name="pole">
        <pose>0 0 -1 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="transducer">
        <pose>0 0 -2 0 0 0</pose>
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><ambient>1 0.85 0.1 1</ambient><diffuse>1 0.85 0.1 1</diffuse></material>
      </visual>
    </link>

    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <publish_rate>20</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </model>
</sdf>
