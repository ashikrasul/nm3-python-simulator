Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (10 m)
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 20
      Plane: XY
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/MarkerArray
      Name: NM3 localisation
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nm3/markers
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 2
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Keep: 1
  Enabled: true
  Global Options:
    Background Color: 30; 34; 40
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 90
      Focal Point:
        X: 10
        Y: -7
        Z: -10
      Pitch: 0.75
      Yaw: 4.2
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
