<?xml version="1.0"?>
<sdf version="1.6">
  <world name="nm3_beacon">
    <!-- No gravity: the agent is a kinematic surface vessel driven by planar_move. -->
    <gravity>0 0 0</gravity>
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.5 0.5 0.55 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Water surface at z = 0 (visual only). -->
    <model name="water_surface">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>400 400 0.02</size></box></geometry>
          <transparency>0.6</transparency>
          <material><ambient>0.1 0.35 0.6 1</ambient><diffuse>0.1 0.35 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 10 m reference grid just below the surface. -->
    <model name="grid">
      <static>true</static>
      <link name="link">
        <visual name="x_axis">
          <pose>10 0 -0.05 0 0 0</pose>
          <geometry><box><size>20 0.1 0.02</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <visual name="y_axis">
          <pose>0 10 -0.05 0 0 0</pose>
          <geometry><box><size>0.1 20 0.02</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>-25 -35 40 0 0.75 0.95</pose>
      </camera>
    </gui>
  </world>
</sdf>
